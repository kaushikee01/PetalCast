# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file or share it.

PORT=3000
NODE_ENV=development

# A long random string used to sign login tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Where the SQLite database file lives (relative to the project folder)
DB_PATH=data/petalcast.db

# Websites allowed to call the API from a browser (comma separated)
CORS_ORIGINS=http://localhost:3000

# Set to true when the app sits behind a proxy/host such as Render, Railway or Nginx
TRUST_PROXY=false

# Weather alerts: run the checker, and how often (cron format, default every 30 minutes)
RUN_ALERTS=true
ALERT_CRON=*/30 * * * *

# Optional: email for alerts. Leave SMTP_HOST empty to use in-app notifications only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=PetalCast <no-reply@example.com>
